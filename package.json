{
  "name": "refined-testmailapp",
  "version": "0.2.0",
  "private": true,
  "description": "Renders testmail.app raw JSON API responses as a readable inbox UI.",
  "type": "module",
  "scripts": {
    "build:chrome": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "zip:chrome": "wxt zip -b chrome --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3"
  },
  "dependencies": {
    "lucide-solid": "^1.48.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@wxt-dev/module-solid": "^1.1.4",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.1",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.4"
  }
}
