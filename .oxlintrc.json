{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "message": "Use the @/ alias. Only ./ relative imports are allowed.",
            "regex": "^\\.\\./"
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    ".output",
    ".wxt"
  ]
}
